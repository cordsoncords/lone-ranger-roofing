---
import MainLayout from '../../layouts/MainLayout.astro';
import PreFooterCTA from '../../components/PreFooterCTA.astro';

const city = 'San Antonio';
const county = 'Bexar County';

const services = [
  { title: 'Roof Replacement', href: '/residential-roofing/roof-replacement', body: 'Full tear-off and replacement for San Antonio homes. IKO architectural shingles or metal roofing. Most residential roofs done in one day.' },
  { title: 'Roof Repair', href: '/residential-roofing/roof-repair', body: "Leaks, wind-lifted shingles, and failed flashing fixed at the source, before they turn into interior water damage." },
  { title: 'Storm Damage Repair', href: '/residential-roofing/storm-damage-repair', body: 'Hail and wind damage documentation, insurance claim support, and full repair or replacement for San Antonio homeowners.' },
  { title: 'Roof Inspection', href: '/residential-roofing/roof-inspection', body: "Free roof inspections for San Antonio homeowners: before buying, after a hail storm, or any time you want an honest answer about what's up there." },
  { title: 'Metal Roofing', href: '/residential-roofing/metal-roofing', body: 'Residential and commercial metal roofing in San Antonio. 40+ year lifespan, excellent hail resistance, and better performance in Texas heat.' },
  { title: 'Gutter Installation', href: '/residential-roofing/gutter-installation', body: 'Seamless gutter installation and repair for San Antonio homes. Good drainage protects your foundation during South Texas downpours.' },
];

const weatherConditions = [
  { title: 'Heat and UV', body: 'Long stretches of 100-degree days wear down shingles from the top. Watch for curling edges, cracked or blistered shingles, and granules collecting in your gutters or at the base of your downspouts. Granule loss is one of the first signs a roof is aging faster than it should.' },
  { title: 'Hail', body: "Spring hail in the San Antonio area can bruise shingles and crack the mat underneath without leaving obvious holes. That kind of damage shortens a roof's life and can turn into leaks months later. A free inspection documents it while you still have time to file a claim." },
  { title: 'Wind and Heavy Storms', body: 'Straight-line winds lift and crease shingles, and heavy downpours find any weak flashing around chimneys, vents, and valleys. We check these spots on every inspection, not just the shingles you can see from the ground.' },
  { title: 'Historic Districts and HOAs', body: "If your home is in a designated San Antonio historic district such as King William or Monte Vista, exterior roof work typically needs review from the city's Office of Historic Preservation before it starts. HOA communities often have their own rules on shingle color and style. We check the requirements for your address before we quote the job, so nothing gets approved after the fact." },
];

const communities = ['Alamo Heights, TX', 'Terrell Hills, TX', 'Olmos Park, TX', 'Castle Hills, TX', 'Stone Oak, TX', 'Helotes, TX', 'Leon Valley, TX', 'Schertz, TX', 'King William', 'Monte Vista', 'Dominion', 'Sonterra'];

const nearbyAreas = ['Boerne', 'New Braunfels', 'Cibolo', 'Live Oak', 'Universal City', 'Converse'];

const faqs = [
  {
    q: 'Does Lone Ranger Roofing serve San Antonio, TX?',
    a: 'Yes. Lone Ranger Roofing is a veteran-owned roofing contractor based in Central Texas that serves San Antonio and Bexar County, including Alamo Heights, Terrell Hills, Olmos Park, Castle Hills, Stone Oak, Helotes, Leon Valley, and Schertz. We handle roof replacement, roof repair, storm damage repair, metal roofing, gutters, and free roof inspections. Call (254) 300-1413 to confirm we cover your address.',
  },
  {
    q: 'Does Lone Ranger Roofing help San Antonio homeowners with hail damage insurance claims?',
    a: "Yes. We inspect the roof, document hail and wind damage with photos, and meet your adjuster on the roof so nothing gets missed. The adjuster works for your insurance company, so having someone who knows what damage looks like on your side matters. Many Texas policies set a deadline for reporting storm damage, often within a year of the storm, so don't wait if you think your roof took a hit.",
  },
  {
    q: 'How much does a roof replacement cost in San Antonio?',
    a: "Most San Antonio asphalt shingle roof replacements run roughly $9,000 to $18,000, depending on roof size, pitch, and whether the decking needs repair. Metal roofing costs more up front and lasts decades longer. We give you a written estimate after a free inspection, and we offer financing through Hearth if you'd rather spread the cost out.",
  },
  {
    q: 'How long does a roof replacement take in San Antonio?',
    a: 'Most residential roof replacements are finished in one day with one crew and a dedicated on-site supervisor. Larger or more complex roofs, and roofs that need decking repairs, can take longer. We tell you what to expect before we start.',
  },
  {
    q: 'How do I know if my San Antonio roof has hail or heat damage?',
    a: "For hail, look for dents or dark bruised spots on shingles, dings on vents and gutters, and loose granules. For heat, look for curling or cracked shingles and granules piling up in your gutters. Many hail bruises can't be seen from the ground, so a free inspection is the reliable way to find out.",
  },
  {
    q: 'Can you work on roofs in San Antonio historic districts or HOA neighborhoods?',
    a: "Yes. Roof work in a designated historic district like King William or Monte Vista typically needs review from the city's Office of Historic Preservation, and many HOAs, such as those near Dominion and Sonterra, have their own material and color rules. We check the requirements for your address before quoting, so the approved plan and the finished roof match.",
  },
  {
    q: 'Does Lone Ranger Roofing do commercial roofing in San Antonio?',
    a: 'Yes. We install commercial metal and shingle roofing for San Antonio business and property owners, with on-site panel fabrication and dedicated supervision.',
  },
  {
    q: 'Does Lone Ranger Roofing offer financing for roof replacement in San Antonio?',
    a: 'Yes. We partner with Hearth to offer flexible financing for roof repairs and replacements, including $0-down options and promotional interest rates on qualifying plans.',
  },
  {
    q: 'Is Lone Ranger Roofing insured to work in San Antonio?',
    a: 'Yes. Lone Ranger Roofing is fully insured, and every job is backed by a warranty on both materials and labor.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://lonerangerroofing.com/service-areas/san-antonio/#webpage",
      "url": "https://lonerangerroofing.com/service-areas/san-antonio/",
      "name": "Roofing in San Antonio, TX | Lone Ranger Roofing",
      "about": { "@id": "https://lonerangerroofing.com/#business" },
      "isPartOf": {
        "@type": "RoofingContractor",
        "@id": "https://lonerangerroofing.com/#business",
        "areaServed": [
          { "@type": "City", "name": "San Antonio", "containedInPlace": { "@type": "AdministrativeArea", "name": "Bexar County, Texas" } }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": { "@type": "Answer", "text": faq.a }
      }))
    }
  ]
};
---

<MainLayout
  title={`Roofing in ${city}, TX | Lone Ranger Roofing | (254) 300-1413`}
  description={`Lone Ranger Roofing serves ${city}, TX with roof replacement, hail damage repair, and free inspections. Veteran-owned. Call (254) 300-1413.`}
  darkHero={true}
>

  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- ===================== HERO ===================== -->
  <section class="relative min-h-[65vh] flex items-center bg-brand-900 overflow-hidden -mt-28">
    <div class="absolute inset-0">
      <img src="/sanantonio1.webp" alt={`Roofing contractor in ${city}, TX`} loading="eager" decoding="async" fetchpriority="high" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-900 via-brand-900/85 to-brand-900/40"></div>
    </div>
    <div class="relative z-10 container mx-auto px-4 pt-20 pb-28">
      <div class="max-w-2xl">
        <p class="text-gold-400 font-bold text-sm uppercase tracking-widest mb-4">Service Area — {county}</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-tight mb-6">Roofing in {city}, TX</h1>
        <p class="text-xl text-gray-200 leading-relaxed mb-8">Veteran-owned roofing contractor serving San Antonio and Bexar County. Residential and commercial. One-day completions on most roofs, insurance claim support, and warranty on materials and labor.</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="bg-accent-600 hover:bg-accent-700 text-white font-black px-8 py-4 rounded-lg text-sm uppercase tracking-wide transition-colors text-center shadow-lg">Get a Free San Antonio Estimate</a>
          <a href="tel:+12543001413" class="border-2 border-white/50 hover:border-white text-white font-bold px-8 py-4 rounded-lg text-sm uppercase tracking-wide transition-colors text-center hover:bg-white/10">Call (254) 300-1413</a>
        </div>
        <div class="flex flex-wrap gap-x-6 gap-y-3 mt-10">
          {['Residential & Commercial', 'One-Day Completions', 'Hail Damage Specialists'].map(t => (
            <div class="flex items-center gap-2 text-gray-300 text-sm">
              <svg class="w-4 h-4 text-gold-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              {t}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== INTRO ===================== -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-accent-600 font-bold text-sm uppercase tracking-widest mb-3">YOUR SAN ANTONIO ROOFER</p>
          <h2 class="text-3xl sm:text-4xl font-black text-brand-900 mb-6">San Antonio Roofs Get Cooked in Summer and Hammered in Spring. Lone Ranger Is Ready.</h2>
          <p class="text-gray-600 leading-relaxed mb-4">San Antonio roofs don't get an off season. Triple-digit summers break down shingle granules and bake the sealant that holds shingles in place. Then spring brings hail, and one bad storm can bruise every roof on the block. Most of that damage is invisible from the driveway. Homeowners usually find it later as a brown stain on a ceiling.</p>
          <p class="text-gray-600 leading-relaxed mb-4">Lone Ranger Roofing is veteran-owned and operates out of Central Texas. We extend service into San Antonio because we'd rather do the job right than watch the market fill up with storm chasers who show up after the hail and are gone by the holidays. You get one crew, a dedicated on-site supervisor, one day on most roofs, and a warranty on both materials and labor from a company you can still reach after the job is done.</p>
          <p class="text-gray-600 leading-relaxed mb-6">We serve Alamo Heights, Terrell Hills, Olmos Park, Castle Hills, Stone Oak, Helotes, Leon Valley, Schertz, and neighborhoods across Bexar County. That includes the historic streets of King William and Monte Vista and the HOA communities around Dominion and Sonterra. Call <a href="tel:+12543001413" class="font-bold text-accent-600 hover:underline">(254) 300-1413</a> for a free San Antonio roof inspection.</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="bg-accent-600 hover:bg-accent-700 text-white font-black px-6 py-3 rounded-lg text-sm uppercase tracking-wide transition-colors text-center">Free San Antonio Estimate</a>
            <a href="tel:+12543001413" class="border border-brand-900 text-brand-900 hover:bg-brand-900 hover:text-white font-bold px-6 py-3 rounded-lg text-sm uppercase tracking-wide transition-colors text-center">(254) 300-1413</a>
          </div>
        </div>
        <div class="relative">
          <img
            src="/sanantonio2.webp"
            alt="Roofing in San Antonio, TX — Lone Ranger Roofing"
            class="w-full h-[480px] object-cover object-top rounded-2xl shadow-xl"
          />        </div>
      </div>
    </div>
  </section>

  <!-- ===================== LOCAL ROOFING CONDITIONS ===================== -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="text-center mb-12">
        <p class="text-accent-600 font-bold text-sm uppercase tracking-widest mb-3">LOCAL ROOFING CONDITIONS</p>
        <h2 class="text-3xl sm:text-4xl font-black text-brand-900">What San Antonio Weather Does to a Roof</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {weatherConditions.map(cond => (
          <div class="bg-white rounded-2xl p-7 shadow-sm border border-gray-100 flex flex-col gap-3">
            <h3 class="font-black text-brand-900 text-lg">{cond.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{cond.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="bg-gray-50">
    <div class="relative py-16 overflow-hidden">
      <div class="absolute inset-0">
        <img src="/home-gallery1.webp" alt={`Roofing services in ${city}, TX`} loading="eager" decoding="async" fetchpriority="high" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-brand-900/80"></div>
      </div>
      <div class="relative z-10 container mx-auto px-4 max-w-6xl text-center">
        <p class="text-gold-400 font-bold text-sm uppercase tracking-widest mb-3">{`SERVICES IN ${city.toUpperCase()}`}</p>
        <h2 class="text-3xl sm:text-4xl font-black text-white mb-4">Roofing Services Available in {city}, TX</h2>
        <p class="text-gray-200 max-w-2xl mx-auto">From full roof replacements to repairs and storm damage restoration, Lone Ranger Roofing handles it all for San Antonio homeowners and commercial property owners.</p>
      </div>
    </div>
    <div class="py-14 container mx-auto px-4 max-w-6xl">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">
        {services.map(svc => (
          <a href={svc.href} class="bg-white rounded-2xl p-7 shadow-sm border border-gray-100 hover:border-accent-600/30 hover:shadow-md transition-all flex flex-col gap-3 group">
            <h3 class="font-black text-brand-900 text-lg group-hover:text-accent-600 transition-colors">{svc.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed flex-1">{svc.body}</p>
            <span class="text-accent-600 font-bold text-xs uppercase tracking-wide flex items-center gap-1">
              Learn More
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
      <div class="bg-brand-900 rounded-2xl px-8 py-8 text-center mb-5">
        <svg class="w-6 h-6 text-gold-400 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <h3 class="font-black text-white text-base mb-2">San Antonio Communities We Serve</h3>
        <p class="text-brand-200 text-sm leading-relaxed mb-4 max-w-xl mx-auto">
          Lone Ranger Roofing serves residential and commercial properties across the following San Antonio communities.
        </p>
        <div class="flex flex-wrap gap-2 justify-center">
          {communities.map(c => (
            <span class="border border-white/30 text-white text-xs font-semibold px-3 py-1.5 rounded-full hover:border-white/60 transition-colors">{c}</span>
          ))}
        </div>
      </div>
      <div class="bg-brand-900 rounded-2xl px-8 py-8 text-center">
        <svg class="w-6 h-6 text-gold-400 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <h3 class="font-black text-white text-base mb-2">Also Serving the Areas Around San Antonio</h3>
        <p class="text-brand-200 text-sm leading-relaxed mb-4 max-w-xl mx-auto">
          We also serve the areas around San Antonio — {nearbyAreas.join(', ')}. If you're just outside the city, call and we'll confirm coverage.
        </p>
        <div class="flex flex-wrap gap-2 justify-center">
          {nearbyAreas.map(area => (
            <span class="border border-white/30 text-white text-xs font-semibold px-3 py-1.5 rounded-full hover:border-white/60 transition-colors">{area}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 max-w-3xl">
      <div class="text-center mb-12">
        <p class="text-accent-600 font-bold text-sm uppercase tracking-widest mb-3">COMMON QUESTIONS</p>
        <h2 class="text-3xl sm:text-4xl font-black text-brand-900">Roofing in {city}, TX — Frequently Asked Questions</h2>
      </div>
      <div class="space-y-3">
        {faqs.map(faq => (
          <div class="bg-gray-50 rounded-xl border border-gray-200 overflow-hidden faq-item">
            <button class="w-full text-left px-6 py-5 flex justify-between items-center gap-4 faq-trigger" aria-expanded="false">
              <span class="font-bold text-brand-900 text-sm leading-snug">{faq.q}</span>
              <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-answer hidden px-6 pb-5">
              <p class="text-gray-600 text-sm leading-relaxed">{faq.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <PreFooterCTA
    overline="SAN ANTONIO'S ROOFING CONTRACTOR"
    title={`Get a Free Roofing Estimate in ${city}, TX`}
    blurb="Lone Ranger Roofing serves San Antonio homeowners and commercial property owners with one-day completions, hail damage insurance support, and full material and labor warranties. Veteran-owned and honest. For every roof inspection we perform, we contribute $50 to our Roof-A-Vet fund."
    bgImage="/pre-footer-background.webp"
    cityPlaceholder="San Antonio"
  />

</MainLayout>

<script>
  document.querySelectorAll('.faq-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const answer = item?.querySelector('.faq-answer');
      const icon = btn.querySelector('.faq-icon');
      const isOpen = !answer?.classList.contains('hidden');
      document.querySelectorAll('.faq-answer').forEach(a => a.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => i.classList.remove('rotate-180'));
      document.querySelectorAll('.faq-trigger').forEach(b => b.setAttribute('aria-expanded', 'false'));
      if (!isOpen) {
        answer?.classList.remove('hidden');
        icon?.classList.add('rotate-180');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
